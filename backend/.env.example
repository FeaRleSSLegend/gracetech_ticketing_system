# Template for backend/.env -- copy to .env and fill in real values.
# Contains no secrets and IS committed. The real .env is not.
#
#   cp .env.example .env
#
# On Render, set these same names in the service's Environment dashboard
# rather than deploying a .env file.

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset while ENV=production, the app refuses to start.
SECRET_KEY=

# Leave blank to use the local SQLite file (backend/ticketdatabase.db).
# Render sets this automatically when a Postgres instance is attached.
DATABASE_URL=

# "production" on Render; anything else is treated as development.
ENV=development

# Optional: seed the first admin on startup, so no shell access is needed.
# All three must be set or the step is skipped entirely. Once the account
# exists, later startups detect it and do nothing.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
