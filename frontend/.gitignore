# Dependency directories
node_modules/
jspm_packages/

# Local env files (keeps secrets, API keys, and passwords safe)
.env
.env.local
.env.*.local

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js build output — this is Next's equivalent of dist/build,
# do NOT skip this one or you'll commit the entire build/Turbopack cache
.next/

# Production build outputs (other tooling / static export)
dist/
build/
out/

# IDE / System files
.DS_Store
.vscode/
.idea/